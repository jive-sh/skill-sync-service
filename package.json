{
  "name": "@jive-sh/skill-sync-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The service behind @jive-sh/skill-sync: file index in D1, contents in R2, passkey login.",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@jive-sh/skill-sync": "^0.7.0",
    "@jive-sh/workflow-platform": "^0.3.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "elkjs": "0.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  },
  "scripts": {
    "jive:cicd:get-config": "bun -e \"process.stdout.write(JSON.stringify(require('./package.json').jive))\"",
    "jive:cicd:build": "bun run build:client && wrangler deploy --dry-run --outdir dist",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "jive:cicd:deploy:plan": "echo '{\"deploy\":true,\"url\":\"https://skill-sync.jive.sh/\"}'",
    "jive:cicd:upload-artifacts": "true",
    "jive:cicd:deploy": "bun run build:client && bun run schema && wrangler deploy",
    "schema": "wrangler d1 execute jive-skill-sync-db --remote --file src/schema.sql",
    "dev": "bun run build:client && wrangler dev --port 8799 --local",
    "build:client": "bun build src/client/refinement-tab.tsx --outdir public --entry-naming refinement.[ext] --asset-naming refinement.[ext] --production --target browser"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Deploy to",
        "branches": {
          "main": [
            "Production"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest",
      "requiredSecrets": [
        "CLOUDFLARE_API_TOKEN"
      ]
    }
  }
}
